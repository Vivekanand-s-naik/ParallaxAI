modules = ["python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["glibcLocales", "libxcrypt", "libyaml"]

[deployment]
deploymentTarget = "autoscale"
run = ["streamlit", "run", "app.py", "--server.port", "5000"]

[workflows]
runButton = "ParallaxAI Full Stack"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ParallaxAI"

[[workflows.workflow]]
name = "ParallaxAI"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run main.py --server.port 5000 --server.address 0.0.0.0 --server.headless true"
waitForPort = 5000

[[workflows.workflow]]
name = "ParallaxAI Full Stack"
author = 44319669
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python start_app.py"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 80

[[ports]]
localPort = 8501
externalPort = 3000
