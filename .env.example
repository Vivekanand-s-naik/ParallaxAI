# ============================================================================
# ParallaxAI — Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# Never commit .env or actual secrets to version control.
# ============================================================================

# Application Environment (development | testing | production)
APP_ENV=development
APP_NAME="ParallaxAI — AI Governance Command Center"
APP_VERSION=2.0.0
DEBUG=true

# PostgreSQL Configuration (Dedicated Docker Compose service maps 5433 -> 5432)
POSTGRES_USER=parallaxai
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=parallaxai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://parallaxai:change_me_in_production@localhost:5433/parallaxai_db
DATABASE_URL_SYNC=postgresql+psycopg://parallaxai:change_me_in_production@localhost:5433/parallaxai_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# JWT & Session Security
JWT_SECRET_KEY=replace_with_a_strong_64_char_random_hex_secret_key_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_SECRET=replace_with_a_strong_session_secret

# CORS & Security
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5000","http://127.0.0.1:5000"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=3
RATE_LIMIT_API_PER_MINUTE=100
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_HOUR=10

# Google OAuth 2.0 / OIDC (Leave empty to keep Google Sign-In disabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# AI Provider Integrations (Optional — features degrade gracefully when unset)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

